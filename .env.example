# Env for local development (DATABASE_URL uses localhost)
# See README.md -> "Configuration (environment variables)" for full details.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name

# Long random string used to sign JWT tokens
SECRET_KEY=change-me

# Must refer to an existing active plan in the DB (migrations seed FREE)
DEFAULT_PLAN_NAME=FREE

# Optional: admin seeding (used by: `poetry run python -m app.scripts.create_superuser`)
# Keep these commented in templates; set real values only in your local `.env`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_FULL_NAME=Admin