# Env for Docker containers (DATABASE_URL uses "db" hostname)
# See README.md -> "Configuration (environment variables)" for full details.
APP_ENV=docker
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/db_name

# Long random string used to sign JWT tokens
SECRET_KEY=change-me

# Must refer to an existing active plan in the DB (migrations seed FREE)
DEFAULT_PLAN_NAME=FREE

# Postgres container settings (must be consistent with DATABASE_URL above)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# Optional: admin seeding (used by: `poetry run python -m app.scripts.create_superuser`)
# Keep these commented in templates; set real values only in your `.env.docker`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_FULL_NAME=Admin